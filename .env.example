# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_ENV=local
APP_URL=http://localhost/benehom
SESSION_IDLE_TIMEOUT=1800

NUMA_ENABLED=false
NUMA_PUBLIC_ENABLED=false
NUMA_PUBLIC_DAILY_LIMIT=15
NUMA_PUBLIC_MONTHLY_LIMIT=60
NUMA_PUBLIC_GLOBAL_DAILY_CALL_LIMIT=40
NUMA_PUBLIC_GLOBAL_MONTHLY_CALL_LIMIT=400
NUMA_PUBLIC_HASH_KEY=
NUMA_MAX_MESSAGE_LENGTH=300
NUMA_MAX_REQUEST_BODY_BYTES=2048
NUMA_MAX_PROVIDER_RESPONSE_BODY_BYTES=65536
NUMA_CHAT_BURST_MAX_REQUESTS=5
NUMA_CHAT_BURST_WINDOW_SECONDS=60
NUMA_CHAT_BURST_BLOCK_SECONDS=60
NUMA_BYPASS_LIMITS=false
NUMA_LIMIT_EXEMPT_USER_IDS=
NUMA_DAILY_LIMIT=15
NUMA_MONTHLY_LIMIT=60
NUMA_RESERVATION_TTL_SECONDS=120
NUMA_PROVIDER=gemini
NUMA_MODEL=gemini-3.1-flash-lite
NUMA_API_KEY=
NUMA_MAX_INPUT_TOKENS=16000
NUMA_MAX_OUTPUT_TOKENS=1000
NUMA_MAX_PROVIDER_CALLS=9
NUMA_PROVIDER_TIMEOUT_SECONDS=10
NUMA_REQUEST_TIMEOUT_SECONDS=25
NUMA_MAX_TRANSIENT_RETRIES=1
NUMA_GLOBAL_DAILY_PROVIDER_CALL_LIMIT=100
NUMA_GLOBAL_MONTHLY_PROVIDER_CALL_LIMIT=1000
NUMA_GLOBAL_DAILY_TOKEN_LIMIT=100000
NUMA_GLOBAL_MONTHLY_TOKEN_LIMIT=600000
NUMA_EMBEDDING_PROVIDER=gemini
NUMA_EMBEDDING_MODEL=gemini-embedding-001
NUMA_EMBEDDING_DIMENSIONS=768
NUMA_RAG_EVALUATION_DB_HOST=localhost
NUMA_RAG_EVALUATION_DB_PORT=3306
NUMA_RAG_EVALUATION_DB_NAME=
NUMA_RAG_EVALUATION_DB_USER=
NUMA_RAG_EVALUATION_DB_PASS=
NUMA_MAX_RAG_RESULTS=3
NUMA_MAX_RAG_CHUNK_CHARS=900
NUMA_RAG_MIN_SIMILARITY=0.67
NUMA_MAX_TOOL_CALLS=5
NUMA_MAX_TOOL_RESULT_CHARS=1600
NUMA_MAX_TOOL_RANGE_DAYS=731

# Production example:
# APP_ENV=production
# APP_URL=https://benehom.es


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Testing:
# phpunit.xml forces DB_NAME=benehom_test.
# DB_HOST, DB_PORT, DB_USER and DB_PASS can be overridden by the environment.


# -----------------------------------------------------------------------------
# SMTP / transactional email
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=BeneHom

# Hostinger Email production example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=support@benehom.es
# SMTP_FROM=support@benehom.es
# SMTP_FROM_NAME=BeneHom
